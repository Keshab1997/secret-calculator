rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{roomId}/{fileName} {
      // Objects contain client-side AES-GCM ciphertext. Listing is disabled;
      // object names are random and plaintext is never uploaded.
      allow get: if request.auth != null
                 && roomId.matches('^[A-Z0-9]{6}$');
      allow list: if false;
      allow create: if request.auth != null
                    && roomId.matches('^[A-Z0-9]{6}$')
                    && request.resource != null
                    && request.resource.size <= 5 * 1024 * 1024 + 28
                    && request.resource.contentType == 'application/octet-stream';
      allow delete: if request.auth != null
                    && roomId.matches('^[A-Z0-9]{6}$');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
